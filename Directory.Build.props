<Project>

  <PropertyGroup Label="Identity">
    <Product>Afip.Arca.Sdk</Product>
    <Company>Globant POC</Company>
    <Authors>Marcos Rios</Authors>
    <Copyright>Copyright (c) 2026 Marcos Rios</Copyright>
    <PackageProjectUrl>https://github.com/marcosrios/afip-arca-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/marcosrios/afip-arca-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>afip;arca;wsfev1;wsaa;sire;ganancias;argentina;facturacion-electronica</PackageTags>
  </PropertyGroup>

  <PropertyGroup Label="Versioning">
    <VersionPrefix>1.1.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Label="Language">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <!--
      CA1510/CA1512/CA1513: throw helpers requieren BCL nueva; preferimos el throw explícito para multi-target
        (netstandard2.0 no tiene ArgumentNullException.ThrowIfNull, ArgumentException.ThrowIfNullOrWhiteSpace
        ni ObjectDisposedException.ThrowIf).
      CA1716: 'Set' como nombre de método choca con palabras reservadas de VB; aceptamos el riesgo.
      CA1822: marcar métodos como static por puro estilo, no por funcionalidad; lo dejamos al criterio del autor.
      CA1848: LoggerMessage delegates aceleran logs en hot-path; en este SDK los logs son muy esporádicos.
      CA1859: pedir tipos concretos en retorno baja el desacoplamiento; preferimos abstracciones.
      CA1305: nuestros formatos están localizados explícitamente con CultureInfo.InvariantCulture donde corresponde.
      CA1031: catch general necesario en parseo defensivo de XML.
    -->
    <NoWarn>$(NoWarn);NU5128;CA1510;CA1512;CA1513;CA1716;CA1822;CA1848;CA1859;CA1305;CA1031;CA1062;CA1303;CA2007;CA1054;CA2225;CA1034</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Label="Output">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Centraliza la salida de `dotnet pack` en C:\GLB\artifacts (compartida entre repos). -->
    <PackageOutputPath>C:\GLB\artifacts</PackageOutputPath>
  </PropertyGroup>

</Project>
